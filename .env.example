# webFeed 云函数的 HTTP 访问地址（云开发控制台 → HTTP 访问服务里配的路径）
WEBFEED_URL=https://你的环境ID.service.tcloudbase.com/webfeed
# 和云函数 webFeed 的环境变量 WEB_KEY 一致
WEBFEED_KEY=
# 网站正式域名，用于分享卡片里的绝对链接。部署在 Vercel 上不填也行，会用 Vercel 给的域名
SITE_URL=https://example.com
# 导入菜单：云函数 menuImport 的 HTTP 访问地址（和 webFeed 共用 WEBFEED_KEY）
MENUIMPORT_URL=https://你的环境ID.service.tcloudbase.com/menuimport
# OpenAI 密钥，只给导入菜单用；在 OpenAI 后台给它设每月用量上限
OPENAI_API_KEY=
# 可选，默认 gpt-6-luna
OPENAI_MODEL=
